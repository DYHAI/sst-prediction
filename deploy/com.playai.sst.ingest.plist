<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.playai.sst.ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/dingding/srv/SST_Prediction/deploy/ingest.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/dingding/srv/SST_Prediction</string>

  <key>RunAtLoad</key><true/>

  <!-- 每天两次：北京时间 08:30 和 20:30，分别覆盖 00Z / 12Z 两轮起报 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/dingding/srv/SST_Prediction/logs/ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dingding/srv/SST_Prediction/logs/ingest.err.log</string>
</dict>
</plist>
